APP_ENV=local

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=profilepath
DB_USER=postgres
DB_PASSWORD=changeme

# 32 random bytes, base64-encoded. Generate with:
#   php -r "echo base64_encode(random_bytes(32));"
APP_AES_KEY=

# Brevo (formerly Sendinblue) free tier — 300 emails/day free. Sent via
# Brevo's HTTPS API (not SMTP) since many PaaS hosts block outbound SMTP
# ports. Sign up at https://www.brevo.com, create an API key under
# Settings > SMTP & API > API Keys, and verify a sender under
# Settings > Senders, Domains & Dedicated IPs.
BREVO_API_KEY=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ProfilePath

APP_URL=http://localhost:8000
